<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>🏦 Gestión de Cuentas - Banco Adri</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <style>
      body { background: #f2f4f6; }
      .page-container { background: #f8f9fa; min-height: 100vh; display: flex; align-items: flex-start; padding-top: 3.5rem; }
      .card-create { margin-bottom: 1.5rem; border: 0; box-shadow: 0 6px 18px rgba(32,38,61,0.06); }
      .card-table { border: 0; box-shadow: 0 6px 18px rgba(32,38,61,0.06); }
      .gradient-header {
        background: linear-gradient(90deg, rgba(255,235,238,1) 0%, rgba(255,216,229,1) 100%);
        color: #6b213f;
      }
      .btn-hover:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(32,38,61,0.08); }
      .table thead th { vertical-align: middle; }
      .balance-cell { font-weight: 600; }
      .alert-fixed { position: fixed; top: 1rem; right: 1rem; z-index: 1055; min-width: 260px; }
      @media (max-width: 576px) {
        .page-container { padding: 1rem; }
      }
    </style>
  </head>
  <body>
    <header class="bg-white py-3 shadow-sm">
      <div class="container">
        <h1 class="h4 mb-0">🏦 Gestión de Cuentas - Banco Adri</h1>
      </div>
    </header>

    <main class="page-container">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8">

            <!-- Alerts -->
            <div id="alerts"></div>

            <!-- Crear Nueva Cuenta Card -->
            <div class="card card-create">
              <div class="card-body">
                <h5 class="card-title mb-3">Crear Nueva Cuenta</h5>
                <form action="/api/cuentas" method="post" id="createAccountForm" novalidate>
                  <div class="row g-2">
                    <div class="col-sm-4">
                      <label for="userId" class="form-label">Usuario ID</label>
                      <input type="number" class="form-control" id="userId" name="userId" min="1" required>
                      <div class="invalid-feedback">Ingrese el ID del usuario.</div>
                    </div>

                    <div class="col-sm-4">
                      <label for="tipoCuenta" class="form-label">Tipo de Cuenta</label>
                      <select class="form-select" id="tipoCuenta" name="tipoCuenta" required>
                        <option value="">Seleccionar...</option>
                        <option value="Ahorro">AHORRO</option>
                        <option value="Corriente">CORRIENTE</option>
                      </select>
                      <div class="invalid-feedback">Seleccione un tipo de cuenta.</div>
                    </div>

                    <div class="col-sm-4">
                      <label for="saldoInicial" class="form-label">Saldo Inicial</label>
                      <input type="number" class="form-control" id="saldoInicial" name="saldoInicial" step="0.01" min="0" required>
                      <div class="invalid-feedback">Ingrese un saldo inicial válido.</div>
                    </div>
                  </div>

                  <div class="mt-3">
                    <button type="submit" class="btn btn-success btn-hover">
                      <i class="bi bi-plus-lg me-1"></i> Crear Cuenta
                    </button>
                  </div>
                </form>
              </div>
            </div>

            <!-- Cuentas Existentes Card -->
            <div class="card card-table">
              <div class="card-header gradient-header">
                <div class="d-flex justify-content-between align-items-center">
                  <h6 class="mb-0">Cuentas Existentes</h6>
                  <small class="text-muted"><%= (typeof accounts !== 'undefined' && accounts.length) ? accounts.length + ' cuentas' : 'Sin cuentas aún' %></small>
                </div>
              </div>
              <div class="card-body p-0">
                <div class="table-responsive">
                  <table class="table mb-0 align-middle">
                    <thead>
                      <tr>
                        <th style="width:8%;">ID</th>
                        <th style="width:20%;">Usuario ID</th>
                        <th style="width:20%;">Tipo</th>
                        <th class="text-end" style="width:22%;">Saldo</th>
                        <th class="text-center" style="width:30%;">Acciones</th>
                      </tr>
                    </thead>
                    <tbody id="accountsTableBody">
                      <% const serverAccounts = (typeof accounts !== 'undefined') ? accounts : []; %>
                      <% serverAccounts.forEach(function(acc){ %>
                        <tr data-id="<%= acc.id %>">
                          <td><%= acc.id %></td>
                          <td><%= acc.userId %></td>
                          <td><%= acc.tipo %></td>
                          <td class="text-end balance-cell"><%= new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP' }).format(acc.saldo) %></td>
                          <td class="text-center">
                            <button class="btn btn-sm btn-primary btn-hover me-2 btn-edit" title="Editar"><i class="bi bi-pencil"></i> ✏️</button>
                            <button class="btn btn-sm btn-danger btn-hover btn-delete" title="Eliminar"><i class="bi bi-trash"></i> 🗑️</button>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </main>

    <!-- Bootstrap JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script id="serverAccountsData" type="application/json"><%- JSON.stringify(typeof accounts !== 'undefined' ? accounts : []) %></script>


    <script>
      // Inicializa datos desde servidor
      const serverAccounts = JSON.parse(document.getElementById('serverAccountsData').textContent || '[]');
      let nextId = serverAccounts.length ? Math.max(...serverAccounts.map(a => a.id)) + 1 : 1;

      // Util: formatear moneda
      function formatCurrency(value) {
        const val = Number(value) || 0;
        return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP' }).format(val);
      }

      // Mostrar alerta temporal
      function showAlert(message, type = 'success') {
        const container = document.getElementById('alerts');
        const wrapper = document.createElement('div');
        wrapper.className = `alert alert-${type} alert-fixed alert-dismissible fade show`;
        wrapper.role = 'alert';
        wrapper.innerHTML = `${message}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>`;
        container.appendChild(wrapper);
        setTimeout(() => {
          try { bootstrap.Alert.getOrCreateInstance(wrapper).close(); } catch (e) {}
        }, 3500);
      }

      // Añadir fila a la tabla
      function appendAccountRow(acc) {
        const tbody = document.getElementById('accountsTableBody');
        const tr = document.createElement('tr');
        tr.setAttribute('data-id', acc.id);
        tr.innerHTML = `
          <td>${acc.id}</td>
          <td>${acc.userId}</td>
          <td>${acc.tipo}</td>
          <td class="text-end balance-cell">${formatCurrency(acc.saldo)}</td>
          <td class="text-center">
            <button class="btn btn-sm btn-primary btn-hover me-2 btn-edit" title="Editar"><i class="bi bi-pencil"></i> ✏️</button>
            <button class="btn btn-sm btn-danger btn-hover btn-delete" title="Eliminar"><i class="bi bi-trash"></i> 🗑️</button>
          </td>
        `;
        tbody.prepend(tr);
      }

      // Manejo de envío del formulario
      (function(){
        const form = document.getElementById('createAccountForm');
        form.addEventListener('submit', function(e){
          e.preventDefault();
          // validación nativa + chequeo extra
          if (!form.checkValidity()) {
            form.classList.add('was-validated');
            showAlert('Por favor corrija los campos marcados.', 'danger');
            return;
          }
          const userId = Number(document.getElementById('userId').value);
          const tipo = document.getElementById('tipoCuenta').value;
          const saldo = Number(document.getElementById('saldoInicial').value);
          if (!userId || !tipo || isNaN(saldo)) {
            showAlert('Datos incompletos o inválidos.', 'danger');
            return;
          }

          const newAccount = { id: nextId++, userId, tipo, saldo };
          appendAccountRow(newAccount);
          form.reset();
          form.classList.remove('was-validated');
          showAlert('Cuenta creada correctamente.', 'success');
        });
      })();

      // Delegación de eventos para editar / eliminar
      document.getElementById('accountsTableBody').addEventListener('click', function(e){
        const btn = e.target.closest('button');
        if (!btn) return;
        const tr = btn.closest('tr');
        const id = tr?.getAttribute('data-id');

        // Eliminar
        if (btn.classList.contains('btn-delete')) {
          if (!confirm('¿Confirma que desea eliminar esta cuenta?')) return;
          tr.remove();
          showAlert('Cuenta eliminada correctamente.', 'success');
          return;
        }

        // Editar (simple prompt para ejemplo)
        if (btn.classList.contains('btn-edit')) {
          const currentUserId = tr.children[1].textContent.trim();
          const currentTipo = tr.children[2].textContent.trim();
          const currentSaldoText = tr.children[3].textContent.trim().replace(/[^\d,.-]/g,'').replace(',', '.');
          const newUserId = prompt('Usuario ID:', currentUserId);
          if (newUserId === null) return;
          const newTipo = prompt('Tipo (Ahorro / Corriente):', currentTipo);
          if (newTipo === null) return;
          const newSaldo = prompt('Saldo:', currentSaldoText);
          if (newSaldo === null) return;

          // Validaciones simples
          if (!newUserId.trim() || !newTipo.trim() || isNaN(Number(newSaldo))) {
            showAlert('Edición inválida. Los cambios no fueron guardados.', 'danger');
            return;
          }

          tr.children[1].textContent = newUserId;
          tr.children[2].textContent = newTipo;
          tr.children[3].textContent = formatCurrency(Number(newSaldo));
          showAlert('Cuenta actualizada correctamente.', 'success');
        }
      });
    </script>
  </body>
</html>

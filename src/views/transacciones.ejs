<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>💸 Transacciones | Banco Adri</title>
  <link rel="stylesheet" href="/styles.css">

  <style>
    body {
      font-family: "Poppins", sans-serif;
      background: linear-gradient(to bottom right, #ffe6f0, #fff5fa);
      margin: 0;
      padding: 0;
    }

    .card {
      background: #fff;
      border-radius: 25px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
      width: 90%;
      max-width: 900px;
      margin: 60px auto;
      padding: 30px 50px;
      text-align: center;
    }

    h1 {
      color: #cc2b7b;
      margin-bottom: 10px;
      font-size: 2.2em;
    }

    h2 {
      color: #99004d;
      margin-top: 30px;
      font-size: 1.3em;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 25px;
      border-radius: 15px;
      overflow: hidden;
    }

    th, td {
      padding: 14px;
      text-align: center;
      border-bottom: 1px solid #f3cce0;
    }

    th {
      background-color: #ffe0f0;
      color: #99004d;
      text-transform: uppercase;
      font-size: 0.9em;
    }

    tr:hover {
      background-color: #fff0f8;
    }

    .saldo {
      color: #660033;
      font-weight: 600;
    }

    /* 🌸 FORMULARIO */
    form {
      margin-top: 20px;
      text-align: left;
    }

    label {
      display: block;
      margin: 10px 0 5px;
      font-weight: 600;
      color: #660033;
    }

    input, select {
      width: 100%;
      padding: 10px;
      border: 1px solid #ffcce0;
      border-radius: 10px;
      outline: none;
      transition: border 0.3s;
    }

    input:focus, select:focus {
      border-color: #ff80b3;
    }

    .btn {
      display: inline-block;
      background-color: #ffb3d9;
      color: #660033;
      padding: 10px 18px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: background 0.3s;
      margin-top: 10px;
    }

    .btn:hover {
      background-color: #ff99cc;
    }

    .volver {
      display: inline-block;
      margin-top: 20px;
      color: #cc2b7b;
      font-size: 0.9em;
      text-decoration: none;
    }

    .volver:hover {
      text-decoration: underline;
    }

    .alert {
      background-color: #ffe0f0;
      border-left: 5px solid #ff66a3;
      padding: 10px 15px;
      margin-bottom: 15px;
      border-radius: 10px;
      color: #660033;
      font-size: 0.9em;
      text-align: left;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>💸 Transacciones</h1>
    <p style="color:#660033; font-weight:600;">Cuenta N° <%= cuentaId %></p>

    <% if (error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Tipo</th>
          <th>Monto</th>
          <th>Fecha</th>
        </tr>
      </thead>
      <tbody>
        <% if (transacciones.length > 0) { %>
          <% transacciones.forEach(t => { %>
            <tr>
              <td><%= t.id %></td>
              <td><%= t.tipo %></td>
              <td class="saldo">$<%= t.monto.toLocaleString() %></td>
              <td><%= new Date(t.fecha).toLocaleString() %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4">No hay transacciones registradas aún 🌸</td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <h2>➕ Nueva transacción</h2>

    <form action="/transacciones/crear" method="POST">
      <input type="hidden" name="cuentaId" value="<%= cuentaId %>">

      <label for="tipo">Tipo:</label>
      <select name="tipo" id="tipo" required>
        <option value="">Seleccione...</option>
        <option value="DEPOSITO">Depósito</option>
        <option value="RETIRO">Retiro</option>
      </select>

      <label for="monto">Monto:</label>
      <input type="number" name="monto" id="monto" step="0.01" min="1" required>

      <button type="submit" class="btn">💰 Guardar Transacción</button>
    </form>

    <a href="/cuentas" class="volver">⬅️ Volver a cuentas</a>
  </div>
</body>
</html>

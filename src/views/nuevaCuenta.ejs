<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Crear Nueva Cuenta</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <h1>Crear Nueva Cuenta</h1>

  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

 <form action="/cuentas/crear" method="POST" class="needs-validation" novalidate>
  <div class="mb-3">
    <label class="form-label">Usuario ID</label>
    <input 
      type="number" 
      name="usuarioId"
      class="form-control" 
      required
      min="1"
    >
    <div class="invalid-feedback">
      Ingrese un ID de usuario válido
    </div>
  </div>
  
  <div class="mb-3">
    <label class="form-label">Tipo de Cuenta</label>
    <select name="tipoCuenta" class="form-select" required>
      <option value="">Seleccionar...</option>
      <option value="AHORRO">Ahorro</option>
      <option value="CORRIENTE">Corriente</option>
    </select>
    <div class="invalid-feedback">
      Seleccione un tipo de cuenta
    </div>
  </div>
  
  <div class="mb-3">
    <label class="form-label">Saldo Inicial</label>
    <input 
      type="number" 
      name="saldoInicial"
      class="form-control" 
      required
      min="0"
      step="0.01"
    >
    <div class="invalid-feedback">
      Ingrese un saldo inicial válido
    </div>
  </div>

  <button type="submit" class="btn btn-success">
    <i class="bi bi-plus-circle me-1"></i>
    Crear Cuenta
  </button>
</form>

  <a href="/cuentas">Volver al listado</a>
</body>
</html>
